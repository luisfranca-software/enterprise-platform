# =============================================================================
# Enterprise Platform — Environment Variables
# =============================================================================
# This file documents every supported external configuration variable.
# It is the canonical contract between the application and deployment
# environments.
#
# - Copy this file to .env for local development (optional).
# - NEVER commit .env or real secrets to version control.
# - Deployment environments (CI/staging/production) MUST inject these
#   variables externally (e.g. container orchestration, CI/CD secrets).
# =============================================================================

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.example.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DATABASE_URL is optional. When absent the application falls back to a local
# SQLite database at implementation/backend/db.sqlite3.
#
# PostgreSQL example (uncomment for production-like environments):
# DATABASE_URL=postgres://user:password@localhost:5432/enterprise_platform

# ---------------------------------------------------------------------------
# Internationalization
# ---------------------------------------------------------------------------
LANGUAGE_CODE=en-us
TIME_ZONE=UTC
USE_TZ=True

# ---------------------------------------------------------------------------
# Static & Media Files
# ---------------------------------------------------------------------------
STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media

# ---------------------------------------------------------------------------
# Security (Production)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Email (Production SMTP)
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@example.com
