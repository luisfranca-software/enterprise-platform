# ===========================================================================
# Django Settings – Environment Variables
# ===========================================================================
# Copy this file to env/.env.dev and adjust for local development,
# or create env/.env.prod / env/.env.test with the appropriate values.
# ===========================================================================

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate a strong key with: python -c "from django.core.management.utils
# . import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me

# Boolean. Must be False in production / staging.
DEBUG=True

# Comma-separated list of allowed host/domain names.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Connection string. Supports SQLite and PostgreSQL.
#   SQLite:     sqlite:///path/to/db.sqlite3
#   PostgreSQL: postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# ---------------------------------------------------------------------------
# Internationalisation
# ---------------------------------------------------------------------------
LANGUAGE_CODE=pt-br
TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# Static / Media files
# ---------------------------------------------------------------------------
STATIC_URL=/static/
MEDIA_URL=/media/
STATIC_ROOT=staticfiles
MEDIA_ROOT=media
